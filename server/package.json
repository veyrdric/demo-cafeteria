{
  "name": "cafeteria-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "prisma migrate deploy && prisma db seed && tsx src/index.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true
  }
}
